<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        允许明文 HTTP。
        校内大量子系统没有 HTTPS；web_fetch 也要读校外仍只有 HTTP 的部门站、新闻站。
        Android 9+ 默认禁明文，不在这里放开的话请求会被系统直接拒绝。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">xjtu.edu.cn</domain>
        <domain includeSubdomains="false">202.117.17.144</domain>
        <domain includeSubdomains="false">10.6.18.2</domain>
    </domain-config>
</network-security-config>
