<?xml version="1.0" encoding="utf-8"?>
<!--
  智能卡片的元数据。

  `minHeight=110dp` 是**上限不是配额**（§7.3）：布局那边把主区做成 0dp + weight=1，
  内容再多也只会被裁，底栏永远留在卡内；能不能放得下由 SmartLayout 的高度预算先算清楚。

  `resizeMode="horizontal|vertical"` ⇒ 用户能把它拖成 4×2、2×4，所以两套初始布局各一份，
  `SmartWidgetProvider.onAppWidgetOptionsChanged` 会按实例的实际宽度在紧凑/宽之间切换。
  给系统预览（选择器里那张图）用紧凑那份，因为默认就是 2×2。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/smart_widget_name"
    android:description="@string/smart_widget_desc"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_smart_compact"
    android:previewLayout="@layout/widget_smart_compact"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
