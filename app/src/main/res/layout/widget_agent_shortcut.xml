<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_widget"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/agent_shortcut_widget_title"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_agent_chip_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="@string/agent_widget_ask_schedule"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_agent_chip_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="@string/agent_widget_ask_room"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_agent_chip_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="@string/agent_widget_ask_card"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp" />
</LinearLayout>
