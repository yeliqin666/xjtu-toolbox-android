<?xml version="1.0" encoding="utf-8"?>
<!--
  智能卡片在选择器里的**静态预览**（`android:previewLayout`）。

  为什么单独做一个文件：真正的 `widget_smart_compact.xml` 里每一行都要运行时才填，
  在选择器里预览时全是 GONE —— 用户在小组件列表里看到的是一张**空白卡**，根本认不出是什么。
  这个文件把一屏真实内容写死在里面，只给选择器看，运行时不碰它
  （运行时用的是 compact / wide 两套，`initialLayout` 也是 compact）。

  里面的 `android:tint` 是安全的：这个布局只会被桌面**inflate** 一次，不会被 RemoteViews
  的动作改到（`setInt("setColorFilter")` 那套只作用于运行时的两套布局）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_widget"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="上课中"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="高等数学(甲)"
        android:textColor="@color/widget_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="已刷卡 · 待结算"
        android:textColor="#FF2E6BE6"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="还剩 35 分钟"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="11sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="余额 ¥128.60"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="考勤"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_attendance"
            android:tint="@color/widget_on_surface" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:contentDescription="扫码"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_qr"
            android:tint="@color/widget_on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="刷新"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_on_surface_secondary" />
    </LinearLayout>

</LinearLayout>
