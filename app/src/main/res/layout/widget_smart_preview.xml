<?xml version="1.0" encoding="utf-8"?>
<!--
  智能卡片在选择器里的**静态预览**（`android:previewLayout`）。

  为什么单独做一个文件：两套运行时布局的内容全是运行时填进去的，在选择器里预览时一片空白，
  用户认不出这是什么。这个文件把一屏真实内容写死在里面，只给选择器看；
  运行时用的是 compact / wide 两套，`initialLayout` 也是 compact。

  结构必须与 `widget_smart_compact.xml` 一致（同样的留白、块内的键、底部提示 + 刷新），
  否则预览和真机看到的不是一个东西。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_widget"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="上课中"
                android:textColor="@color/widget_on_surface_secondary"
                android:textSize="10sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:contentDescription="扫码"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_qr"
                android:tint="@color/widget_on_surface" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="高等数学(甲)"
            android:textColor="@color/widget_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="已刷卡 · 待结算 · 刷卡 09:58"
            android:textColor="#FF2E6BE6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="还剩 35 分钟"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="余额 ¥128.60 · 考试 3 天"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:contentDescription="刷新"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_on_surface_secondary" />
    </LinearLayout>

</LinearLayout>
