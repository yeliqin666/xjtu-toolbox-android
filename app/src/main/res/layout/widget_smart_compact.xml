<?xml version="1.0" encoding="utf-8"?>
<!--
  智能卡片 · 紧凑形态（宽 < 220dp）：块上下排。

    ┌ 块 1（weight=1，内容垂直居中）
    │   场景（强调色）……………… (键)(键)
    │   标题（单块且放得下时放大成主数字）
    │   状态
    │   细节 ×0–2（高度够才有）
    ├ 块 2（只有两件事时出现；两块各自垫一层深一档的底，代替分隔线）
    └ 底部条：次要提示 …………………… 刷新

  ⚠️ 三件不能破的事：
  1. 只能用 RemoteViews 白名单里的控件（裸 <View> 会让整张卡加载失败）。
  2. 两套布局的控件 id 完全一致 —— RemoteViews 找不到 id 会抛 ActionException。
  3. 行高写死 dp，与 SmartLayout 的常量逐条对应（SmartWidgetLayoutBudgetTest 盯着）。
  块的底色和内边距由 SmartWidgetProvider 按块数设置，这里不写。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_smart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_widget"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- ══════ 块 1 ══════ -->
    <LinearLayout
        android:id="@+id/widget_smart_block1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_smart_label1"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_smart_key1a"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_key"
                android:contentDescription="@string/smart_widget_name"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_smart_key1b"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_key"
                android:contentDescription="@string/smart_widget_name"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_smart_title1"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_smart_status1"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_smart_detail1"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_smart_detail1b"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══════ 块 2 ══════ -->
    <LinearLayout
        android:id="@+id/widget_smart_block2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_smart_label2"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_smart_key2a"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_key"
                android:contentDescription="@string/smart_widget_name"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_smart_key2b"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_key"
                android:contentDescription="@string/smart_widget_name"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_smart_title2"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_smart_status2"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_smart_detail2"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_smart_detail2b"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_smart_hint"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_smart_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/smart_widget_refresh"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
