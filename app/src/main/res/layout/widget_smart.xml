<?xml version="1.0" encoding="utf-8"?>
<!-- 智能卡片：一行场景标签、一行主信息、一行补充、底部一个去处。内容由 SmartWidgetUpdater 按时间填 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_smart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_smart_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/smart_widget_name"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_smart_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_smart_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_smart_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
