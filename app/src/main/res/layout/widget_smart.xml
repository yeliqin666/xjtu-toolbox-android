<?xml version="1.0" encoding="utf-8"?>
<!--
  智能卡片：一行场景标签、一行主信息、一行补充、底部一个去处。内容由 SmartWidgetUpdater 按时间填。

  ⚠️ 布局里只能出现 RemoteViews 白名单里的控件。裸 <View>（占位撑高那种）不在白名单里——
  RemoteViews 反序列化后会拿自己当 LayoutInflater.Filter（onLoadClass 只放行带
  @RemoteViews.RemoteView 注解的类，android.view.View 没有这个注解），
  撞上就抛 InflateException，桌面显示「加载失败」并把整张卡片画成错误占位。
  <Space> 同理（它也是直接 extends View）。撑高留白用空 TextView，它是白名单内的。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_smart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_smart_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/smart_widget_name"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_smart_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_smart_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="12sp" />

    <!-- 本堂考勤状态：上课那一屏直接摆在这里，用户不用点进去就知道记上没有。
         没有状态时整行 GONE（见 SmartWidgetUpdater.update），文字色按状态换。 -->
    <TextView
        android:id="@+id/widget_smart_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 上面那句话是什么时候的事实（「3 分钟前查过」/「刷卡 14:14」/「还未查询过」）。
         学校系统没有推送，卡片只能定时间去问；如实标出时刻，用户才不会被一句过期的结论误导。 -->
    <TextView
        android:id="@+id/widget_smart_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 撑开中间空白：必须是 RemoteViews 白名单内的控件，所以用空 TextView 而不是 <View>/<Space> -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_smart_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
