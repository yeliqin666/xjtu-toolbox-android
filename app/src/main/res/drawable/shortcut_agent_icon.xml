<?xml version="1.0" encoding="utf-8"?>
<!-- 启动器 shortcut 必须自带底：白矢量叠透明会被浅色弹层吃掉。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/shortcut_agent_bg" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/shortcut_agent"
        android:gravity="center"
        android:left="11dp"
        android:top="11dp"
        android:right="11dp"
        android:bottom="11dp" />
</layer-list>
