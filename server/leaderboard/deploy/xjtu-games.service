[Unit]
Description=XJTU Toolbox 小游戏全服榜
Documentation=https://github.com/yeliqin666/xjtu-toolbox-android
After=network.target

[Service]
Type=simple
# 用一个专用的受限用户：这个服务只需要能读写自己的工作目录。
# 机器上已经有 www 就直接复用——给每个服务单开一个无登录权限的用户是更严的做法，
# 但对一台机器上的几个小服务来说，一个共用受限用户更好管。
User=www
Group=www
WorkingDirectory=/opt/xjtu-games
ExecStart=/usr/bin/node index.js
Environment=NODE_ENV=production
Environment=PORT=4100
Environment=DB_PATH=/opt/xjtu-games/data.db
Restart=always
RestartSec=3

# 加固：只读系统目录，进程自己只能写工作目录和临时目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
